{
  "name": "property-finder-fullstack",
  "version": "1.0.0",
  "description": "PropertyFinder fullstack application",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "nodemon src/server.js",
    "start": "node src/server.js",
    "build:frontend": "cd frontend && npm run build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["real-estate", "property", "api", "smythos"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.50.0",
    "concurrently": "^8.2.0"
  }
}
